# ---------------------------------------
# sojkafinance.cz – čisté URL bez .html + HTTPS
# ---------------------------------------
RewriteEngine On
RewriteBase /

### 1) Vynutit HTTPS
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

### 2) /index.html  ->  /   (i v podsložkách)
RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[\s?] [NC]
RewriteRule ^(.*/)?index\.html$ /$1 [R=301,L]

### 3) /stranka.html -> /stranka  (SEO kanonikalizace)
RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

### 4) Interní obsluha čistých URL – když neexistuje soubor/dir,
###    ale existuje stejnojmenné .html, převeď interně na něj
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+?)/?$ $1.html [L]

### 5) Výchozí soubor ve složkách
DirectoryIndex index.html
